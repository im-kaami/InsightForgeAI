# Select an OpenAI-compatible provider or deterministic offline mode.
LLM_PROVIDER=openai  # or fake
# Provider API key; OPENAI_API_KEY is also accepted as a fallback.
LLM_API_KEY=
# Leave empty for OpenAI; Gemini: https://generativelanguage.googleapis.com/v1beta/openai/; Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./insightforge.db
STORAGE_DIR=./storage
JWT_SECRET=change-me
APP_SECRET=change-me
ACCESS_TOKEN_MINUTES=10080
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]
# Start recurring schedule jobs with the API process.
SCHEDULER_ENABLED=true
# Create SQLAlchemy tables automatically for local development.
AUTO_CREATE_TABLES=true
