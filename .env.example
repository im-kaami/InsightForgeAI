# openai | gemini | groq | ollama | openai-compatible | fake
LLM_PROVIDER=openai
# Provider API key; OPENAI_API_KEY is also accepted as a fallback.
LLM_API_KEY=
# Optional provider base URL override; required for openai-compatible.
LLM_BASE_URL=
# Optional model override; each provider has a default model.
LLM_MODEL=
# Optional prices for cost estimates on the Usage page, as JSON: USD per million tokens, keyed by the
# exact model name. Without a price a run's cost shows as unknown; nothing is guessed.
# LLM_PRICES={"openai/gpt-oss-20b": {"input": 0.075, "output": 0.30}}
# development logs secret problems; production refuses unsafe settings.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./insightforge.db
STORAGE_DIR=./storage
JWT_SECRET=change-me
APP_SECRET=change-me
ACCESS_TOKEN_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000"]
SCHEDULER_ENABLED=true
AUTO_CREATE_TABLES=true
ALLOW_PRIVATE_URLS=false
QUERY_TIMEOUT_SECONDS=60
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
MAX_CONCURRENT_RUNS_PER_USER=2
# Analysis runs execute in a durable queue: at most RUN_WORKERS at once; a run interrupted by a
# restart is retried until it has been tried RUN_MAX_ATTEMPTS times, then marked failed.
RUN_WORKERS=4
RUN_MAX_ATTEMPTS=2
# Sign-in rate limit per email (not per IP): after this many failed sign-ins within the window the
# email is locked until the window passes. Anyone can lock a known email this way; that is the trade-off.
LOGIN_MAX_FAILURES=5
# Email (optional): alert emails and "Forgot password?". Off unless SMTP_HOST and SMTP_FROM are set.
# Emails hold names and a link, never data values. SMTP_SECURITY is starttls, ssl or none (none only
# for a server on this computer). APP_BASE_URL is the address people use for InsightForge; links use it.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
LOGIN_WINDOW_MINUTES=15
MAX_UPLOAD_BYTES=200000000
LLM_SEND_SAMPLE_VALUES=true
LLM_SUMMARY_MAX_ROWS=20
# Optional model for "local only" datasets, served by Ollama on this computer (for example qwen3:4b).
# Leave empty to keep local-only chat on the basic offline planner.
LOCAL_LLM_MODEL=
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_CONTEXT_TOKENS=8192
LOCAL_LLM_MAX_OUTPUT_TOKENS=1024
LOCAL_LLM_THINK=false
LOCAL_LLM_TIMEOUT_SECONDS=300
# Deep mode limits (review-and-revise rounds).
DEEP_MAX_ROUNDS=3
DEEP_MAX_SECONDS=300
DEEP_MAX_TOKENS=40000
# Python sandbox for "python" plan steps. Needs Docker and the image built once with:
#   docker build -t insightforge-sandbox:1 backend/sandbox
# Code runs with no network, a read-only filesystem, no capabilities and these limits.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=insightforge-sandbox:1
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
# Single sign-on with OpenID Connect (Google, Microsoft Entra ID, Okta, Auth0, ...). Off until the
# issuer, client id, client secret and redirect URI are all set. Register this redirect URI with the
# provider: the frontend address followed by /api/auth/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_PROVIDER_NAME=single sign-on
OIDC_SCOPES=openid email profile
# Optional: only these email domains may sign in, as a JSON list, e.g. ["company.com"].
OIDC_ALLOWED_DOMAINS=[]
OIDC_FRONTEND_URL=http://localhost:3000
